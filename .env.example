# Local-development SQLite fallback only. Netlify uses NVO_DATABASE_URL instead.
NVO_DB_PATH=data/nvo.sqlite
# Production server database URL. For Netlify, copy Supabase's Transaction pooler
# connection string (port 6543), not the Session pooler (port 5432). Keep it
# server-only; never commit the real connection URL.
NVO_DATABASE_URL=
# The project URL (not secret) from Supabase Connect. Used only by server-side
# media storage. The secret key must be server-only; never prefix either with NEXT_PUBLIC_.
NVO_SUPABASE_URL=
NVO_MEDIA_BUCKET=nvo-media
SUPABASE_SECRET_KEY=
# One-time source connection for copying SQLite data to Supabase. Keep blank
# until the database migration script is ready to run; never deploy this value.
NVO_MIGRATION_DATABASE_URL=
ADMIN_EMAIL=owner@nvo.local
# Generate your private login with npm run setup. Never commit .env.local.
ADMIN_PASSWORD=
# Set true only behind HTTPS in production.
SECURE_COOKIES=false
SITE_URL=http://localhost:3000
# Keep the Node server private behind your reverse proxy in production.
HOSTNAME_BIND=127.0.0.1
# Exact trusted proxy socket IPs, comma-separated. Leave empty for direct local use.
# The trusted proxy MUST overwrite this single client-IP header.
TRUSTED_PROXY_IPS=
TRUSTED_IP_HEADER=x-real-ip
# Optional Google Maps Embed API key restricted to your website and Maps Embed API.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Run npm run setup:social once. Keep this 32-byte base64 key stable across deploys.
SOCIAL_TOKEN_KEY=
# Local only: embedded uses the custom local server; external uses npm run social:worker.
# On Netlify set this to scheduled; netlify/functions/social-tick.ts runs every minute.
SOCIAL_WORKER_MODE=embedded
# A long random secret used only between Netlify's edge function and the API
# server to validate the visitor IP for coupon limits. Set it in Netlify too.
NVO_INTERNAL_IP_KEY=
# Meta: choose the supported version shown in your app dashboard (format vNN.0).
META_API_VERSION=
META_APP_ID=
META_APP_SECRET=
# Instagram Login uses the Instagram App ID/Secret shown under Instagram API setup,
# separate from the Meta app credentials above.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# TikTok Login Kit + Content Posting upload permission. Verify the SITE_URL domain.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# WhatsApp Cloud API: server system-user token with messaging and management access.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Approved MARKETING templates: IMAGE header, one positional body variable, no buttons.
WHATSAPP_TEMPLATE_FR=
WHATSAPP_TEMPLATE_FR_LOCALE=fr
WHATSAPP_TEMPLATE_EN=
WHATSAPP_TEMPLATE_EN_LOCALE=en
# Optional. Standard captions work without AI. Set a Responses-compatible model.
OPENAI_API_KEY=
OPENAI_CAPTION_MODEL=
# Netlify automatic English/French translation is opt-in because local OPUS
# models do not fit a serverless function bundle. Requires OPENAI_API_KEY.
OPENAI_TRANSLATION_MODEL=

# Guest analytics ignore localhost and development by default. Only enable on
# an isolated test database for analytics verification; keep false for real use.
ANALYTICS_ALLOW_LOCAL=false
