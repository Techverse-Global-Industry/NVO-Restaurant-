# Install the completed file as /etc/nvo/nvo.env, readable by root only.
# Never place real credentials in this example.
NODE_ENV=production
PORT=3000
HOSTNAME_BIND=127.0.0.1
SITE_URL=https://nvo.example.com
SECURE_COOKIES=true
NVO_DB_PATH=/srv/nvo/data/nvo.sqlite
TRUSTED_PROXY_IPS=127.0.0.1
TRUSTED_IP_HEADER=x-real-ip
SOCIAL_WORKER_MODE=embedded
ANALYTICS_ALLOW_LOCAL=false
# Supply the existing bootstrap values privately. Existing staff passwords
# are stored in SQLite; changing these does not reset those passwords.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Preserve the existing key when migrating encrypted social connections.
SOCIAL_TOKEN_KEY=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Add provider variables from .env.example when accounts are ready.
